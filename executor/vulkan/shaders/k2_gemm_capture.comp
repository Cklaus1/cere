#version 460
// VulkanAmd P4-B: TEST BUILD ONLY (k2_gemm_vk.cpp under CERE_VK_K2_CAPTURE; never in the default library, AGENTS.md
// 14): copies a GEMM call's x operand (BF16 [m, k]) into a host-visible capture buffer, 16 bytes per thread.
#include "k2_gemm_common.comp"

layout(local_size_x = 256) in;
layout(push_constant, std430) uniform PC {
    uint64_t src, dst;
    uint vecs, pad0;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i < pc.vecs) V4(pc.dst + uint64_t(i) * 16u).v = ld16(pc.src, i * 16u);
}
