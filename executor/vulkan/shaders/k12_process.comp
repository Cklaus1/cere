#version 460
#extension GL_GOOGLE_include_directive : require
#define WG 256
#include "k12_common.comp"
// VulkanAmd P2 K12 process (D2 without the temperature) and logit_bias (-DBIAS=1). Same arithmetic as sampler_ref::process:
// out = fp32(bf16), counts > 0: x - (f * c + p) (f * c one fp32 multiply, no contraction), then x < 0 ? x * r : x / r with the
// division correctly rounded (fdiv_rn32); ids whose bit is clear in mask -> -inf. BIAS: out[ids[j * stride]] += values[j * stride].
layout(local_size_x = 256) in;
layout(push_constant, std430) uniform PC {
    uint64_t logits, counts, mask, dst;
    uint64_t bias_ids, bias_values;
    uint vocab, bias_stride, bias_count;
    float f, p, r;
} pc;
void main() {
    const uint i = gl_GlobalInvocationID.x;
#if BIAS
    if (i >= pc.bias_count) return;
    const uint id = ldu(pc.bias_ids, i * pc.bias_stride);
    precise float s = ldf(pc.dst, id) + ldf(pc.bias_values, i * pc.bias_stride);
    stf(pc.dst, id, s);
#else
    if (i >= pc.vocab) return;
    float x = uintBitsToFloat(uint(H1(pc.logits + uint64_t(i * 2u)).v) << 16);
    if (pc.counts != 0ul) {
        const uint c = ldu(pc.counts, i);
        if (c > 0u) {
            precise float fc = pc.f * float(c);
            precise float sub = fc + pc.p;
            x = x - sub;
            x = x < 0.0 ? x * pc.r : fdiv_rn32(x, pc.r);
        }
    }
    if (pc.mask != 0ul && ((ldu(pc.mask, i >> 5) >> (i & 31u)) & 1u) == 0u) x = f_ninf();
    stf(pc.dst, i, x);
#endif
}
