#version 460
// VulkanAmd P2 K6: dense_attention's output gate after the prefill kernel (K1 sigmoid_mul's expression, the same
// statement k6_combine.comp applies on the split path): out[t, c] = bf16(float(a[t, c]) * (1 / (1 + exp(-gate[t, c])))),
// a the BF16 attention output [tokens, 6144] (contiguous), BF16 RNE with NaN 0x7FFF.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require

#define QW 6144
layout(local_size_x = 256) in;

layout(buffer_reference, std430, buffer_reference_align = 2) readonly buffer H16r { uint16_t v; };
layout(buffer_reference, std430, buffer_reference_align = 2) writeonly buffer H16 { uint16_t v; };

layout(push_constant, std430) uniform PC {
    uint64_t a, gate, dst;
    uint tokens, out_stride, gate_stride, pad;
} pc;

uint bf16_rne(float x) {
    const uint u = floatBitsToUint(x);
    return isnan(x) ? 0x7FFFu : (u + 0x7FFFu + ((u >> 16) & 1u)) >> 16;
}

void main() {
    const uint c = gl_GlobalInvocationID.x, t = gl_WorkGroupID.y;
    if (c >= QW) return;
    const uint b = uint(H16r(pc.a + uint64_t((t * QW + c) * 2u)).v);
    const float gv = uintBitsToFloat(uint(H16r(pc.gate + uint64_t((t * pc.gate_stride + c) * 2u)).v) << 16);
    precise float sg = 1.0 / (1.0 + exp(-gv));
    precise float a = uintBitsToFloat(b << 16) * sg;
    H16(pc.dst + uint64_t((t * pc.out_stride + c) * 2u)).v = uint16_t(bf16_rne(a));
}
