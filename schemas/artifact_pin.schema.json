{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cere.local/schemas/artifact_pin.schema.json",
  "title": "CERE prepared artifact pin (M2.1 Q3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "path",
    "manifest_sha256",
    "profile_id",
    "lock_id",
    "model_hash",
    "tokenizer_hash",
    "template_hash",
    "source_revision",
    "created_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,110}-[a-f0-9]{16}(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "pattern": "^/[^\\x00]{1,4095}(?![\\s\\S])"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "lock_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "model_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "tokenizer_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "template_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}(?![\\s\\S])"
    },
    "created_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    }
  }
}
