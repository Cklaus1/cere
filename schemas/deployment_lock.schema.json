{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cere.local/schemas/deployment_lock.schema.json",
  "title": "CERE deployment_lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lock_id",
    "recipe_sha256",
    "artifact_sha256",
    "model_content_sha256",
    "tokenizer_sha256",
    "template_sha256",
    "backend_build_sha256",
    "backend_profile_id",
    "effective_context_tokens",
    "effective_operations"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "lock_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "recipe_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "model_content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "tokenizer_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "template_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "backend_build_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "backend_profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "effective_context_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "effective_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "chat",
          "infill",
          "embed",
          "rerank",
          "classify",
          "score"
        ]
      },
      "maxItems": 10000
    },
    "adapter_sha256s": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
      },
      "maxItems": 10000
    }
  }
}
