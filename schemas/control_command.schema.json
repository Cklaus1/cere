{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cere.local/schemas/control_command.schema.json",
  "title": "CERE control command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cluster_id",
    "coordinator_id",
    "coordinator_term",
    "worker_id",
    "worker_epoch",
    "scope_id",
    "operation_id",
    "method",
    "model_generation",
    "payload_sha256",
    "remaining_budget_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "3"
    },
    "cluster_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "coordinator_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "coordinator_term": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "worker_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "worker_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "method": {
      "enum": [
        "load",
        "drain",
        "unload",
        "submit",
        "cancel",
        "describe_resources",
        "query_operation",
        "stream_telemetry"
      ]
    },
    "model_generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "remaining_budget_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    }
  }
}
