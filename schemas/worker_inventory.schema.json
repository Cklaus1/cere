{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cere.local/schemas/worker_inventory.schema.json",
  "title": "CERE worker_inventory",
  "description": "bounded_resource_inventory_json of DescribeResources (tasks/m35-spec.md Q10a, tasks/m36-spec.md Q7); the encoded document is at most 65536 bytes and inventory_sha256 is the SHA-256 of those exact bytes. tp_size, kv_cache_dtype, max_running_requests and instance_id are all set or all null: set in attached mode and in ready, null in unloaded/loading/failed, either in draining/unloading. models[0] repeats served_model_name, instance_id and model_generation, and the string maxLength bounds are UTF-8 bytes (checked by the Rust loader and scripts/cere_contracts.py).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worker_id",
    "served_model_name",
    "tp_size",
    "kv_cache_dtype",
    "max_running_requests",
    "instance_id",
    "model_generation",
    "admission_state",
    "gpus",
    "models",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "served_model_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tp_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "kv_cache_dtype": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "max_running_requests": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "instance_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "model_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "admission_state": {
      "enum": [
        "open",
        "fenced",
        "poisoned"
      ]
    },
    "gpus": {
      "type": "array",
      "maxItems": 0,
      "description": "The agent reads no GPU (M3.5, M3.6)."
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "description": "The worker's one model: lock_sha256 null and state attached for an agent without [backend.launch], else its approved lock and Q4 state.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "served_model_name",
          "lock_sha256",
          "state",
          "instance_id",
          "model_generation"
        ],
        "properties": {
          "served_model_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "lock_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "state": {
            "enum": [
              "attached",
              "unloaded",
              "loading",
              "ready",
              "draining",
              "unloading",
              "failed"
            ]
          },
          "instance_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "model_generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "attached"
                }
              }
            },
            "then": {
              "properties": {
                "lock_sha256": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "lock_sha256": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 0,
      "description": "Artifact locality is out of scope."
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "tp_size": {
              "type": "null"
            },
            "kv_cache_dtype": {
              "type": "null"
            },
            "max_running_requests": {
              "type": "null"
            },
            "instance_id": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "tp_size": {
              "not": {
                "type": "null"
              }
            },
            "kv_cache_dtype": {
              "not": {
                "type": "null"
              }
            },
            "max_running_requests": {
              "not": {
                "type": "null"
              }
            },
            "instance_id": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "models": {
            "items": {
              "properties": {
                "state": {
                  "enum": [
                    "attached",
                    "ready"
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tp_size": {
            "not": {
              "type": "null"
            }
          },
          "kv_cache_dtype": {
            "not": {
              "type": "null"
            }
          },
          "max_running_requests": {
            "not": {
              "type": "null"
            }
          },
          "instance_id": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "models": {
            "items": {
              "properties": {
                "state": {
                  "enum": [
                    "unloaded",
                    "loading",
                    "failed"
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tp_size": {
            "type": "null"
          },
          "kv_cache_dtype": {
            "type": "null"
          },
          "max_running_requests": {
            "type": "null"
          },
          "instance_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
