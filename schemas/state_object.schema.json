{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cere.local/schemas/state_object.schema.json",
  "title": "CERE state_object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "state_type",
    "scope_id",
    "model_fingerprint",
    "input_fingerprint",
    "execution_fingerprint",
    "size_bytes",
    "tier",
    "current_location",
    "generation",
    "token_boundary",
    "immutable",
    "sharing_count",
    "lease_count",
    "reuse_probability"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "state_type": {
      "type": "string",
      "enum": [
        "attention_kv",
        "recurrent",
        "draft",
        "sampler",
        "metadata"
      ]
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "model_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "execution_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "tier": {
      "type": "string",
      "enum": [
        "device_memory",
        "host_ram",
        "nvme"
      ]
    },
    "current_location": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "token_boundary": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "immutable": {
      "type": "boolean"
    },
    "sharing_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "lease_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "reuse_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
