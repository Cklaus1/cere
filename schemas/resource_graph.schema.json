{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cere.local/schemas/resource_graph.schema.json",
  "title": "CERE resource_graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "evidence",
    "nodes",
    "links"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "evidence": {
      "type": "string",
      "enum": [
        "unmeasured",
        "physical_probe",
        "synthetic"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "capacity_bytes",
          "attributes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
          },
          "kind": {
            "type": "string",
            "enum": [
              "machine",
              "gpu",
              "cpu",
              "device_memory",
              "host_memory",
              "nvme"
            ]
          },
          "capacity_bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              {
                "type": "null"
              }
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind",
          "bandwidth_bytes_s",
          "latency_ns",
          "peer_access",
          "contention_domain"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pcie",
              "peer",
              "storage",
              "local",
              "network"
            ]
          },
          "bandwidth_bytes_s": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "latency_ns": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "peer_access": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "contention_domain": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
          }
        }
      },
      "minItems": 0,
      "maxItems": 10000
    }
  }
}
