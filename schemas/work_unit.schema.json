{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cere.local/schemas/work_unit.schema.json",
  "title": "CERE work_unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "work_type",
    "scope_id",
    "session_id",
    "request_id",
    "payload_sha256",
    "artifact_sha256",
    "expected_session_revision",
    "attempt",
    "worker_epoch",
    "priority",
    "deadline_mono_ns",
    "input_tokens",
    "max_new_tokens",
    "estimated_peak_bytes",
    "preemptible",
    "migratable",
    "speculative",
    "state_dependencies",
    "worker_id",
    "coordinator_term",
    "model_generation",
    "deadline_clock_domain"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "work_type": {
      "type": "string",
      "enum": [
        "prefill",
        "decode",
        "verify",
        "draft",
        "state_move",
        "state_restore",
        "tool_wait",
        "load",
        "infill",
        "embed",
        "rerank",
        "classify",
        "score"
      ]
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "expected_session_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "worker_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "deadline_mono_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        {
          "type": "null"
        }
      ]
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "max_new_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "estimated_peak_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "preemptible": {
      "type": "boolean"
    },
    "migratable": {
      "type": "boolean"
    },
    "speculative": {
      "type": "boolean"
    },
    "state_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 10000
    },
    "worker_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "coordinator_term": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "model_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "deadline_clock_domain": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
