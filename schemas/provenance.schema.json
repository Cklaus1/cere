{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cere.local/schemas/provenance.schema.json",
  "title": "CERE native toolchain provenance executor/PROVENANCE.json (tasks/m22-spec.md Q11, X1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "image_digest",
    "captured_utc",
    "toolchain",
    "oracle_packages"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "captured_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nvcc",
        "cuda_runtime",
        "gxx",
        "cmake",
        "ninja",
        "glibc"
      ],
      "properties": {
        "nvcc": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        },
        "cuda_runtime": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        },
        "gxx": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        },
        "cmake": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        },
        "ninja": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        },
        "glibc": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        }
      }
    },
    "oracle_packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "torch",
        "sglang",
        "flashinfer_python",
        "safetensors",
        "triton",
        "transformers",
        "tokenizers"
      ],
      "properties": {
        "torch": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        },
        "sglang": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        },
        "flashinfer_python": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        },
        "safetensors": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        },
        "triton": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        },
        "transformers": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        },
        "tokenizers": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.+][A-Za-z0-9.+-]{1,64})?(?![\\s\\S])"
        }
      }
    }
  }
}
