{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cere.local/schemas/third_party.schema.json",
  "title": "CERE native executor third-party inventory (tasks/m22-spec.md B3, ground rule 'Third-party code')",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system_libraries",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "system_libraries": {
      "description": "Dynamic NEEDED names provided by the host driver or the base system, never shipped by CERE (X1 set).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "provided_by"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.+-]{1,128}(?![\\s\\S])"
          },
          "provided_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\x00-\\x1f]+(?![\\s\\S])"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source",
          "revision",
          "license",
          "files",
          "relation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f]+(?![\\s\\S])"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\x00-\\x1f]+(?![\\s\\S])"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f]+(?![\\s\\S])"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f]+(?![\\s\\S])"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f]+(?![\\s\\S])"
            }
          },
          "relation": {
            "description": "linked: a binary CERE links; math_reference: code whose math a CERE kernel follows, nothing copied; vendored: source files copied verbatim under `root` (tasks/m23-spec.md C8), each pinned by `pins` and with its licence retained in `license_files`.",
            "enum": [
              "linked",
              "math_reference",
              "vendored"
            ]
          },
          "root": {
            "description": "vendored only: the repo-relative directory the entry's files are relative to.",
            "type": "string",
            "pattern": "^executor/third_party/[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}(?![\\s\\S])"
          },
          "pins": {
            "description": "vendored only: a file under `root` in wheel RECORD format (path,sha256=<urlsafe base64>,size) pinning every file.",
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}(?![\\s\\S])"
          },
          "license_files": {
            "description": "vendored only: the retained licence texts, each one of `files`.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f]+(?![\\s\\S])"
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\x00-\\x1f]+(?![\\s\\S])"
          }
        }
      }
    }
  }
}
