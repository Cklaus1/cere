{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cere.local/schemas/benchmark_record.schema.json",
  "title": "CERE benchmark_record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "evidence",
    "model_sha256",
    "backend_commit",
    "config_sha256",
    "context_tokens",
    "concurrency",
    "cache_state",
    "window_ns",
    "completed_output_tokens",
    "completed_requests",
    "failed_requests",
    "cancelled_requests",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "evidence": {
      "type": "string",
      "enum": [
        "operator_reported",
        "upstream_reported",
        "local_cpu_test",
        "local_gpu_test",
        "synthetic"
      ]
    },
    "model_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "backend_commit": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "config_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "cache_state": {
      "type": "string",
      "enum": [
        "cold",
        "hot",
        "mixed",
        "unknown"
      ]
    },
    "window_ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "completed_output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "completed_requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "failed_requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "cancelled_requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "notes": {
      "type": "string",
      "maxLength": 4096
    }
  }
}
